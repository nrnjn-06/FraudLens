# ==============================================================================
# FraudLens Environment Configuration Template
# Copy to `.env` for local environment configuration:
#   cp .env.example .env
#
# NEVER commit actual secrets or production API keys to source control.
# ==============================================================================

# Core Application Settings
APP_NAME=FraudLens
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=True
API_HOST=127.0.0.1
API_PORT=8000

# System Release Milestone Flag
CURRENT_STAGE=8

# Image Upload & Computer Vision Limits (QR Code Scanner)
MAX_IMAGE_UPLOAD_BYTES=5242880
MAX_IMAGE_DIMENSION=4096
ENABLE_MULTI_QR=True

# Domain Intelligence Settings (WHOIS/RDAP, Domain Age & Registration)
# Uses open standard ICANN RDAP endpoints. No commercial API key required.
DOMAIN_INTEL_ENABLED=True
DOMAIN_INTEL_TIMEOUT_SECONDS=3.0
DOMAIN_INTEL_CACHE_TTL_SECONDS=86400
DOMAIN_INTEL_MAX_CACHE_ENTRIES=2000
DOMAIN_INTEL_RDAP_BASE_URL=https://rdap.org/domain

# Optional External Threat Intelligence Providers (VirusTotal / URLScan)
# Default: False (runs in self-contained local-only mode with zero external dependencies)
THREAT_INTEL_ENABLED=False
THREAT_INTEL_VIRUSTOTAL_API_KEY=
THREAT_INTEL_URLSCAN_API_KEY=
THREAT_INTEL_TIMEOUT_SECONDS=5.0
THREAT_INTEL_CACHE_TTL_SECONDS=3600
THREAT_INTEL_MAX_CACHE_ENTRIES=1000

# Production ML Model Artifact Paths (relative to repository root)
MESSAGE_MODEL_PATH=backend/models/message_model.joblib
